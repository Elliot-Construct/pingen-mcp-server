# Pingen MCP server configuration - COPY to your shell/env, fill in values.
# NEVER commit real values. Keep the real file OUTSIDE this repository
# (a system config directory or secrets manager) and select it with
# PINGEN_ENV_FILE.

# production | staging  (default: production)
#   production -> https://api.pingen.com      + https://identity.pingen.com
#   staging    -> https://api-staging.pingen.com + https://identity-staging.pingen.com
PINGEN_ENVIRONMENT=staging

# client_credentials | authorization_code  (default: client_credentials)
PINGEN_GRANT_TYPE=client_credentials

# OAuth developer-app credentials (from https://identity.pingen.com or
# https://identity-staging.pingen.com depending on environment)
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=

# Path to an env file holding the keys above (used when the vars are not set)
#PINGEN_ENV_FILE=/secure/location/credentials.env

# Required for authorization_code grant only: registered redirect URI
#PINGEN_REDIRECT_URI=http://localhost:8080/callback

# Optional space-separated scopes (defaults to the app's configured scopes)
#PINGEN_SCOPES=letter batch webhook organisation_read

# Where tokens are stored (default: <user config dir>/pingen-mcp/tokens.json)
#PINGEN_TOKEN_FILE=

# Base URL overrides (mainly for tests)
#PINGEN_API_BASE_URL=
#PINGEN_IDENTITY_BASE_URL=
